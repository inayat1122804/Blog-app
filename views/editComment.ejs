<%- include('partials/header', { title: 'Edit Comment', user: user }) %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

  <div class="card shadow">
    <div class="card-header bg-primary text-white">
      <h3 class="mb-0">Edit Your Comment</h3>
    </div>

    <div class="card-body">

      <!-- Show Post Title -->
      <h5 class="mb-3">
        On Post: <strong><%= post.title %></strong>
      </h5>

      <!-- Error / Success Messages -->
      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <!-- Edit Comment Form -->
      <form action="/posts/<%= post._id %>/comments/<%= comment._id %>?_method=PUT" method="POST">
        
        <div class="mb-3">
          <label class="form-label fw-bold">Edit Comment</label>
          <textarea 
            name="content" 
            class="form-control" 
            rows="5" 
            required><%= comment.content %></textarea>
        </div>

        <div class="d-flex justify-content-between">
          
          <!-- Back Button -->
          <a href="/posts/<%= post._id %>" class="btn btn-secondary">
            Back
          </a>

          <!-- Update Button -->
          <button type="submit" class="btn btn-primary">
            Update Comment
          </button>

        </div>

      </form>

    </div>
  </div>

</div>
  </div>
</div>

<%- include('partials/footer') %>

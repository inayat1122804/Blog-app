<%- include('partials/header', { title, user: user }) %>

<div class="container py-4 " style="height: 76vh;">
  
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">📌 All Posts</h2>
    <a href="/posts/new" class="btn btn-primary">+ Create Post</a>
  </div>

  <% if (posts?.length > 0) { %>

    <div class="row g-4">

      <% posts.forEach((post) => { %>

        <div class="col-md-6 col-lg-4">

          <div class="card h-100 shadow-sm border-0 rounded-4">

            <% if (post?.images?.length) { %>

              <img
                src="<%= post.images[0].url %>"
                class="card-img-top rounded-top-4"
                style="height: 200px; object-fit: cover;"
              >

            <% } else { %>

              <img
                src="https://via.placeholder.com/400x200?text=No+Image"
                class="card-img-top rounded-top-4"
              >

            <% } %>

            <div class="card-body d-flex flex-column">

              <h5 class="card-title fw-semibold">
                <%= post.title %>
              </h5>

              <p class="card-text text-muted small flex-grow-1">
                <%= post.content.substring(0, 100) %>...
              </p>

              <% if (post?.images?.length > 1) { %>

                <div class="d-flex gap-2 mb-2 flex-wrap">

                  <% post.images.slice(1, 4).forEach((img) => { %>

                    <img
                      src="<%= img.url %>"
                      style="width: 60px; height: 60px; object-fit: cover;"
                      class="rounded"
                    >

                  <% }) %>

                </div>

              <% } %>

              <div class="d-flex justify-content-between align-items-center mt-3">

                <a
                  href="/posts/<%= post._id %>"
                  class="btn btn-sm btn-outline-primary"
                >
                  View
                </a>

                <small class="text-muted">
                  <%= new Date(post.createdAt).toLocaleDateString() %>
                </small>

              </div>

            </div>

          </div>

        </div>

      <% }) %>

    </div>

  <% } else { %>

    <div class="text-center py-5">

      <h4 class="text-muted">😕 No Posts Found</h4>

      <p class="text-muted">
        Start by creating your first post
      </p>

      <a href="/posts/new" class="btn btn-primary">
        Create Post
      </a>

    </div>

  <% } %>

</div>

<%- include('partials/footer') %>